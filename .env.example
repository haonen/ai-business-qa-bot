MYSQL_HOST=your-mysql-internal-host
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=ai_business_qa_bot

FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret

DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=glm-5.2
DASHSCOPE_ROUTER_MODEL=glm-5.2
DASHSCOPE_SUMMARY_MODEL=glm-5.2

# Optional BET brand matching controls.
MEDIA_BRAND_LOOKUP_LIMIT=80
MEDIA_BRAND_LLM_CONFIDENCE=0.90
MEDIA_BRAND_LLM_TIMEOUT=12

# Optional MySQL connection-pool and slow-query controls.
MYSQL_POOL_SIZE=3
MYSQL_MAX_OVERFLOW=1
MYSQL_POOL_TIMEOUT=10
MYSQL_CONNECT_TIMEOUT=10
MYSQL_READ_TIMEOUT=60
MYSQL_WRITE_TIMEOUT=30
MYSQL_SLOW_QUERY_SECONDS=2

# Optional Redis/RQ queue. Keep disabled until Redis and workers are installed.
BOT_QUEUE_ENABLED=0
REDIS_URL=redis://127.0.0.1:6379/0
BOT_QUEUE_NAME=ai-bot
BOT_WORKER_COUNT=2
BOT_INNER_QUERY_WORKERS=3
BOT_JOB_TIMEOUT_SECONDS=300
BOT_QUEUE_TTL_SECONDS=3600
BOT_RESULT_TTL_SECONDS=3600
BOT_FAILURE_TTL_SECONDS=604800
BOT_SESSION_TTL_SECONDS=1209600
BOT_MAX_SESSION_BYTES=2097152
BOT_PROGRESS_MIN_INTERVAL_SECONDS=2
BOT_MAX_DB_CONNECTION_BUDGET=8
BOT_ASYNC_DOCUMENTS=1
BOT_DOCUMENT_QUEUE_NAME=ai-bot-documents
BOT_DOCUMENT_WORKER_COUNT=1
BOT_DOCUMENT_TIMEOUT_SECONDS=180
BOT_REQUEST_AUDIT_ENABLED=0
# Use one stable secret value in production so hashed users/chats remain joinable across exports.
BOT_AUDIT_HASH_SALT=replace-with-a-stable-random-secret
LLM_REQUEST_TIMEOUT=30
# Follow-up Skills V2. Shadow logs plans without changing production answers.
FOLLOWUP_SKILL_V2_ENABLED=1
FOLLOWUP_SKILL_V2_SHADOW=0
UNIFIED_RESPONSE_STRATEGY_ENABLED=0
DYNAMIC_META_CAPABILITY_ENABLED=0
MARKET_ANALYSIS_ENABLED=1
FOLLOWUP_PLAN_TIMEOUT=12
# Platform-aware, evidence-first executable follow-up planner. Start in shadow;
# Douyin DB drilldowns are independently gated and never fall back to Tmall.
EC_FOLLOWUP_PLANNER_V2_ENABLED=0
EC_FOLLOWUP_PLANNER_V2_SHADOW=1
DOUYIN_FOLLOWUP_TOOL_ENABLED=0
# Router V2 rollout: start with V2 disabled and shadow logging enabled.
ROUTER_V2_ENABLED=0
ROUTER_V2_SHADOW=1
ENTITY_RESOLVER_V2_ENABLED=0
ENTITY_RESOLVER_V2_SHADOW=1
# Persistent business Task Context. Entity slots are merged deterministically;
# the LLM only classifies turn relation and requested analytical goals.
TASK_CONTEXT_V2_ENABLED=1
TASK_CONTEXT_LLM_ENABLED=1
TASK_CONTEXT_LLM_TIMEOUT=6
TASK_CONTEXT_TRACE_ENABLED=1

# Controlled Agent Plan Layer. Shadow only records validated plans and does not
# change execution. Enable after reviewing plan traces.
AGENT_PLAN_LAYER_ENABLED=0
AGENT_PLAN_LAYER_SHADOW=1
AGENT_PLAN_MAX_STEPS=8
# For complex Top-brand plans, select each brand's largest-growth platform and
# run the corresponding existing Tmall/Douyin/JD business template.
AGENT_PLAN_MARKET_PLATFORM_FANOUT_ENABLED=1
# Executable Plan V2. Keep shadow on first; enable both execution and derive to
# activate the controlled rank-then-drill recipe. Generated plans remain dark.
EXECUTABLE_PLAN_V2_ENABLED=0
EXECUTABLE_PLAN_V2_SHADOW=1
EXECUTABLE_PLAN_DERIVE_ENABLED=0
EXECUTABLE_PLAN_GENERATED_ENABLED=0
# Route-aware Feishu status copy. Disable to restore the legacy generic wording.
BOT_SMART_PROGRESS_ENABLED=1
# Give a grounded one-sentence answer immediately, then attach the full report.
BOT_INLINE_ANSWER_ENABLED=1
BOT_INLINE_ANSWER_TIMEOUT_SECONDS=12
BOT_INLINE_ANSWER_MAX_CHARS=180
BOT_INLINE_ANSWER_REPORT_CHARS=24000

# Douyin product daily analysis V2. Run the offline migration and quality gate
# before enabling shadow or production execution.
DOUYIN_PRODUCT_DAILY_V2_ENABLED=0
DOUYIN_PRODUCT_DAILY_V2_SHADOW=0
DOUYIN_PRODUCT_DAILY_QUALITY_GATE=1
