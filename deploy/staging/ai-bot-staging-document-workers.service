[Unit]
Description=AI Business QA Bot staging document worker
After=network-online.target redis-ai-bot-staging.service
Wants=network-online.target
Requires=redis-ai-bot-staging.service

[Service]
Type=simple
User=ai-bot-staging
Group=ai-bot-staging
Slice=ai-bot-staging.slice
WorkingDirectory=/srv/ai-business-qa-bot-staging/current
EnvironmentFile=/srv/ai-business-qa-bot-staging/config/.env
Environment=BOT_SESSION_BACKEND=redis
Environment=BOT_WORKER_ROLE=document
ExecStart=/srv/ai-business-qa-bot-staging/current/.venv/bin/python -m bot.worker_pool
Restart=always
RestartSec=5
TimeoutStopSec=210
KillMode=mixed
UMask=0077

[Install]
WantedBy=multi-user.target
