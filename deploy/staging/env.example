# Fill secrets directly in /srv/ai-business-qa-bot-staging/config/.env.
# Never reuse the production Feishu application.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

FEISHU_APP_ID=
FEISHU_APP_SECRET=

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=glm-5.2
DASHSCOPE_ROUTER_MODEL=glm-5.2
DASHSCOPE_SUMMARY_MODEL=glm-5.2

MYSQL_POOL_SIZE=1
MYSQL_MAX_OVERFLOW=0
MYSQL_POOL_TIMEOUT=10
MYSQL_CONNECT_TIMEOUT=10
MYSQL_READ_TIMEOUT=30
MYSQL_WRITE_TIMEOUT=15
MYSQL_SLOW_QUERY_SECONDS=2

BOT_QUEUE_ENABLED=1
BOT_SESSION_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6380/0
BOT_QUEUE_NAME=ai-bot-staging
BOT_WORKER_COUNT=1
BOT_INNER_QUERY_WORKERS=1
BOT_JOB_TIMEOUT_SECONDS=300
BOT_QUEUE_TTL_SECONDS=3600
BOT_RESULT_TTL_SECONDS=3600
BOT_FAILURE_TTL_SECONDS=604800
BOT_SESSION_TTL_SECONDS=1209600
BOT_MAX_SESSION_BYTES=2097152
BOT_PROGRESS_MIN_INTERVAL_SECONDS=2
BOT_MAX_DB_CONNECTION_BUDGET=1
BOT_ASYNC_DOCUMENTS=1
BOT_DOCUMENT_QUEUE_NAME=ai-bot-staging-documents
BOT_DOCUMENT_WORKER_COUNT=1
BOT_DOCUMENT_TIMEOUT_SECONDS=180
BOT_REQUEST_AUDIT_ENABLED=1
BOT_AUDIT_HASH_SALT=
LLM_REQUEST_TIMEOUT=30

FOLLOWUP_SKILL_V2_ENABLED=1
FOLLOWUP_SKILL_V2_SHADOW=0
UNIFIED_RESPONSE_STRATEGY_ENABLED=0
DYNAMIC_META_CAPABILITY_ENABLED=0
MARKET_ANALYSIS_ENABLED=1
FOLLOWUP_PLAN_TIMEOUT=12
EC_FOLLOWUP_PLANNER_V2_ENABLED=0
EC_FOLLOWUP_PLANNER_V2_SHADOW=1
DOUYIN_FOLLOWUP_TOOL_ENABLED=0
ROUTER_V2_ENABLED=0
ROUTER_V2_SHADOW=1
ENTITY_RESOLVER_V2_ENABLED=0
ENTITY_RESOLVER_V2_SHADOW=1
TASK_CONTEXT_V2_ENABLED=1
TASK_CONTEXT_LLM_ENABLED=1
TASK_CONTEXT_LLM_TIMEOUT=6
TASK_CONTEXT_TRACE_ENABLED=1
AGENT_PLAN_LAYER_ENABLED=0
AGENT_PLAN_LAYER_SHADOW=1
AGENT_PLAN_MAX_STEPS=8
AGENT_PLAN_MARKET_PLATFORM_FANOUT_ENABLED=1
EXECUTABLE_PLAN_V2_ENABLED=0
EXECUTABLE_PLAN_V2_SHADOW=1
EXECUTABLE_PLAN_DERIVE_ENABLED=0
EXECUTABLE_PLAN_GENERATED_ENABLED=0
BOT_SMART_PROGRESS_ENABLED=1
BOT_INLINE_ANSWER_ENABLED=1
BOT_INLINE_ANSWER_TIMEOUT_SECONDS=12
BOT_INLINE_ANSWER_MAX_CHARS=180
BOT_INLINE_ANSWER_REPORT_CHARS=24000
DOUYIN_PRODUCT_DAILY_V2_ENABLED=0
DOUYIN_PRODUCT_DAILY_V2_SHADOW=0
DOUYIN_PRODUCT_DAILY_QUALITY_GATE=1
